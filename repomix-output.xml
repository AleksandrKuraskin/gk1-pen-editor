#include <stddef.h>

#include "model/point.h"

typedef enum {
  EDGE_CONSTRAINT_NONE = 0,
  EDGE_CONSTRAINT_LENGTH = 1 << 0,
  EDGE_CONSTRAINT_PARALLEL = 1 << 1
} EdgeConstraintType;

typedef enum { EDGE_TYPE_STRAIGHT, EDGE_TYPE_BEZIER, EDGE_TYPE_ARC } EdgeType;

typedef struct {
  Point control1;
  Point control2;
} CubicBezier;

typedef enum { ARC_SIDE_LEFT, ARC_SIDE_RIGHT } ArcSide;

typedef struct {
  ArcSide side;
} ArcGeometry;

typedef struct {
  double length;
} LengthConstraint;

typedef struct {
  struct EdgeNode *target;
  int group_id;
} ParallelConstraint;

typedef struct {
  Point *start;
  Point *end;
  EdgeType type;
  EdgeConstraintType constraint_type;
  int constraint_mask;
  LengthConstraint length;
  ParallelConstraint parallel;
  union {
    CubicBezier bezier;
    ArcGeometry arc;
  } geometry;
} Edge;

typedef struct EdgeNode {
  Edge edge;
  struct EdgeNode *next;
} EdgeNode;

typedef struct {
  EdgeNode *head;
  size_t count;
} EdgeList;

EdgeList *edge_list_create(void);
